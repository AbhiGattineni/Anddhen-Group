rules_version = '2';

// Anddhen Firestore security rules.
// Baseline: every read/write requires an authenticated user (works because Auth
// and Firestore share the same project — request.auth is populated).
//
// Roles live in User/{uid}.role ∈ {user, employee, admin, superadmin}. The
// requester's role is resolved with get() on their own User doc. Bootstrapping
// the first superadmin is done out-of-band via the Admin SDK (firestore/
// setSuperAdmin.js), which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role of the CURRENT requester.
    //
    // Prefers the `role` custom claim, which rides in the ID token and costs
    // nothing to read. The get() fallback stays for accounts whose claim hasn't
    // been synced yet (see functions syncRoleClaim and
    // firestore/syncRoleClaims.js) — dropping it would lock those users out,
    // and it costs a billed document read on every evaluation that needs it.
    function myRole() {
      let path = /databases/$(database)/documents/User/$(request.auth.uid);
      return !signedIn()
        ? 'user'
        : request.auth.token.get('role', '') != ''
          ? request.auth.token.role
          : (exists(path) ? get(path).data.get('role', 'user') : 'user');
    }

    // Bootstrap superadmin(s) by email — keep in sync with SUPERADMIN_EMAILS in
    // src/services/roles/roles.js. Lets the first superadmin operate before any
    // role doc is seeded (breaks the chicken-and-egg without the Admin SDK).
    function isBootstrapSuper() {
      return signedIn() && request.auth.token.email in ['abhishekgattineni@gmail.com'];
    }

    function isAdminish() {
      return myRole() == 'admin' || myRole() == 'superadmin' || isBootstrapSuper();
    }
    function isSuper() {
      return myRole() == 'superadmin' || isBootstrapSuper();
    }

    // Config/reference data: signed-in read, admin-or-above write.
    function adminWritable(col) {
      return col in ['subsidiary', 'access_roles', 'role', 'Packages',
                     'collegelist', 'social_links',
                     'stockParameters', 'stockCompanies', 'stockSnapshots',
                     'quizzes', 'quizQuestions', 'questionSubmissions',
                     'jiraProducts'];
    }

    // --- User docs: role-change protection (no self-elevation) ---
    //     `cardAccess` (dashboard-card grants, see services/roles/cards.js) is
    //     protected exactly like `role`: admin-or-above writes it, and a user
    //     editing their own profile must leave it untouched — otherwise anyone
    //     could grant themselves every card.
    match /User/{uid} {
      allow read: if signedIn();

      // First sign-in may self-create only as a plain `user` with no grants;
      // admins may create anyone.
      allow create: if isAdminish()
        || (request.auth.uid == uid
            && request.resource.data.get('role', 'user') == 'user'
            && request.resource.data.get('cardAccess', []).size() == 0);

      allow update: if
        // Admin/superadmin changing roles or grants, with the superadmin guard:
        (isAdminish()
          && (
            request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
            || isSuper()
            || (request.resource.data.get('role', 'user') != 'superadmin'
                && resource.data.get('role', 'user') != 'superadmin')
          ))
        // OR a user editing their OWN profile, changing neither role nor grants:
        || (request.auth.uid == uid
            && request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
            && request.resource.data.get('cardAccess', [])
                 == resource.data.get('cardAccess', []));

      allow delete: if isAdminish();
    }

    // --- Quiz: players join via QR without an account, so these need PUBLIC
    //     access on top of the admin-only writes granted by adminWritable().
    //     (Rules are OR'd: the catch-all below still gives admins full write.)
    match /quizQuestions/{qId} {
      allow read: if true; // players (possibly anonymous) render questions client-side
    }
    match /quizzes/{quizId} {
      allow read: if true;
      match /players/{playerId} {
        allow read: if true;
        // Anyone (incl. anonymous) may create/update their own player doc.
        // Basic shape guard: bounded field count and a short name.
        allow create, update: if request.resource.data.keys().size() <= 12
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() <= 60;
        allow delete: if isAdminish();
      }
    }
    match /questionSubmissions/{sId} {
      // Public community submissions (pending admin review). Shape-guarded.
      allow create: if request.resource.data.keys().size() <= 10
        && request.resource.data.get('text', '') is string
        && request.resource.data.get('text', '').size() > 0
        && request.resource.data.get('text', '').size() <= 500
        && request.resource.data.get('status', '') == 'pending';
    }

    // --- Transactions: the public philanthropy page (/aps) lists APS rows
    //     without sign-in. Queries MUST filter subsidiary == 'APS' (Firestore
    //     proves it), so other subsidiaries' rows stay signed-in-only via the
    //     catch-all below. Writes unchanged (catch-all).
    match /transactions/{txId} {
      allow read: if resource.data.subsidiary == 'APS';
    }

    // --- Timesheets: entries are PRIVATE to their owner. Admins may read
    //     others' PROFESSIONAL entries only (team view queries must filter
    //     category == 'professional' so Firestore can prove it) — personal
    //     time is never readable by anyone else. Excluded from the catch-all.
    match /timesheetEntries/{entryId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
            || (isAdminish() && resource.data.category == 'professional'));
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().size() <= 12;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Jira board: admins and above, plus employees granted the `jira`
    //     dashboard card (User/{uid}.cardAccess). Anyone with access may create,
    //     edit, move and delete tickets. jiraMeta/board holds the AG-n counter.
    //     Excluded from the catch-all so plain signed-in users can't reach it.
    function canUseJira() {
      return isAdminish()
        || (myRole() == 'employee'
            && 'jira' in get(/databases/$(database)/documents/User/$(request.auth.uid))
                           .data.get('cardAccess', []));
    }
    // A customer issue from the public Contact page: anyone (signed in or not)
    // may create a ticket of exactly this shape, straight into Backlog. Its key
    // must be the next AG-n, and the same write must bump jiraMeta/board.
    function isContactReport() {
      let d = request.resource.data;
      let meta = /databases/$(database)/documents/jiraMeta/board;
      let n = exists(meta) ? get(meta).data.nextNumber : 1;
      return d.keys().hasOnly(['key', 'title', 'description', 'type', 'priority', 'status',
                               'product', 'source', 'contact', 'assigneeUid', 'assigneeName',
                               'reporterUid', 'reporterName', 'createdAt', 'updatedAt'])
        && d.source == 'contact'
        && d.status == 'backlog'
        && d.assigneeUid == '' && d.assigneeName == '' && d.reporterUid == ''
        && d.type in ['task', 'story', 'bug']
        && d.priority in ['highest', 'high', 'medium', 'low']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.description is string && d.description.size() <= 5000
        && d.product is string && d.product.size() > 0 && d.product.size() <= 100
        && d.reporterName is string && d.reporterName.size() <= 100
        && d.contact is map
        && d.contact.keys().hasOnly(['name', 'email', 'phone', 'company'])
        && d.contact.name is string && d.contact.name.size() <= 100
        && d.contact.email is string && d.contact.email.size() <= 200
        && d.contact.phone is string && d.contact.phone.size() <= 20
        && d.contact.company is string && d.contact.company.size() <= 100
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.key == 'AG-' + string(n)
        && getAfter(meta).data.nextNumber == n + 1;
    }
    match /jiraTickets/{ticketId} {
      allow create: if isContactReport();
      allow read, delete: if signedIn() && canUseJira();
      allow create, update: if signedIn() && canUseJira()
        && request.resource.data.keys().size() <= 16
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() > 0
        && request.resource.data.get('title', '').size() <= 200;
    }
    match /jiraMeta/{docId} {
      // Only the ticket counter lives here; the Contact page reads it and may
      // advance it by exactly one (to allocate a key for a customer report).
      allow read: if true;
      allow write: if signedIn() && canUseJira();
      allow create: if docId == 'board'
        && request.resource.data.keys().hasOnly(['nextNumber'])
        && request.resource.data.nextNumber == 2;
      allow update: if docId == 'board'
        && request.resource.data.keys().hasOnly(['nextNumber'])
        && request.resource.data.nextNumber == resource.data.nextNumber + 1;
    }
    // Products/clients shown in the Contact page dropdown: public read; writes
    // are admin-only via adminWritable() in the catch-all below.
    match /jiraProducts/{productId} {
      allow read: if true;
    }

    // --- Statement Analyzer (/ati/finance-data): saved analyses are PRIVATE to
    //     their owner — nobody else, admins included, can read them. Parsed
    //     transactions live in a chunks subcollection; each chunk carries the
    //     owner's uid so it can be checked without reading the parent.
    match /financeAnalyses/{analysisId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      match /chunks/{chunkId} {
        allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      }
    }

    // Statement Analyzer category choices: one private doc per user.
    match /financePrefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // --- Everything else (User, timesheetEntries and the Jira board handled
    //     above; exclude them here so their protections can't be bypassed via
    //     this broad rule) ---
    match /{col}/{docId} {
      allow read: if !(col in ['timesheetEntries', 'jiraTickets', 'jiraMeta', 'financeAnalyses',
                               'financePrefs'])
        && signedIn();
      allow create, update, delete: if !(col in ['User', 'timesheetEntries', 'jiraTickets', 'jiraMeta',
                                                  'financeAnalyses', 'financePrefs'])
        && (adminWritable(col) ? isAdminish() : signedIn());
    }
  }
}
